# Dedicated testnet keys only. Never paste keys into chat or commit .env.
PAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
RPC_URL=https://base-sepolia-rpc.publicnode.com
# Integrated test roles: npm run init:testnet -> ignored .runtime/testnet-roles.json.
# Existing .env.roles may be imported once; no keys are exposed to the browser.
# Contract addresses are read from deployments/base-sepolia.json, not from secrets.

# npm start defaults to the synthetic local demo. For the public testnet:
# DISASTERDAO_PROFILE=testnet npm start
# Private integrated NGO/reviewer keys are initialized by npm run init:testnet
# in ignored .runtime/testnet-roles.json; never copy them into web/public/.
