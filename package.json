{
  "name": "disasterdao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "install:local": "node scripts/install-local.mjs",
    "fetch-response": "node --env-file-if-exists=.env src/fetch-response.ts",
    "request-hash": "node src/request-hash.ts",
    "verify-response": "node src/verify-response.ts",
    "check-real": "node src/check-real.ts",
    "init-demo": "node src/init-demo.ts",
    "deploy": "node --env-file-if-exists=.env --env-file-if-exists=.env.roles src/deploy.ts",
    "estimate-deploy": "node --env-file-if-exists=.env --env-file-if-exists=.env.roles src/estimate-deploy.ts",
    "verify-deployment": "node --env-file-if-exists=.env src/verify-deployment.ts",
    "report": "node src/report.ts",
    "submit-response": "node --env-file-if-exists=.env src/submit-response.ts",
    "tamper": "node --env-file-if-exists=.env src/tamper.ts",
    "local-clock": "node src/local-clock.ts",
    "emergency": "node --env-file-if-exists=.env --env-file-if-exists=.env.roles src/emergency.ts",
    "export-abi": "node src/export-abi.ts",
    "test:ui": "playwright test",
    "record-demo": "node demo/record.mjs",
    "test": "node --test src/vendor/*.test.ts src/*.test.ts src/v3/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "forge": "forge",
    "anvil": "anvil",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.web.json && vite build",
    "v2": "node src/v2.ts",
    "fetch-campaign": "node --env-file-if-exists=.env src/fetch-campaign.ts",
    "test:core": "node --test src/v3/*.test.ts",
    "v3:infra": "docker compose -f compose.v3.yaml up -d --wait",
    "v3:deploy": "node src/v3/deploy.ts",
    "v3:server": "node --watch server/main.ts",
    "v3:worker": "node server/run-worker.ts",
    "v3:integration": "V3_INTEGRATION=1 node --test --test-concurrency=1 server/*.test.ts",
    "v3:start": "node src/v3/start.ts",
    "v3:test:ui": "playwright test --config playwright.v3.config.ts",
    "v3:clock": "node src/v3/clock.ts",
    "v3:verify": "node src/v3/verify.ts",
    "v3:approvals": "node src/v3/approvals.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pnpm": "11.28.9",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
